{
  "ConnectionStrings": {
    "Synnduit": "Server=.;Database=Synnduit;Trusted_Connection=True;multipleactiveresultsets=True;TrustServerCertificate=true"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "WithExceptionDetails"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\IT_Portal\\Sync-DDH-AD\\logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "buffered": false,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}{NewLine}{Properties:j}"
        }
      }
    ]
  },
  "Synnduit": {
    "BinaryFilesDirectoryPath": "./bin",
    "Runs": [
      {
        "Name": "{Your Run Name Goes Here}",
        "SourceSystem": "{Your Source System Name Goes Here}",
        "Segments": [
          {
            "Type": "Migration",
            "EntityType": "{Your Entity Type Goes Here}"
          },
          {
            "Type": "GarbageCollection",
            "EntityType": "{Your Entity Type Goes Here}"
          }
        ]
      }
    ]
  }
}